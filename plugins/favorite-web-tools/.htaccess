# Favorite Web Tools - Web Server Hardening
# Prevent directory listing and direct web access to internal plugin files

Options -Indexes

# Deny direct access to sensitive file extensions
<FilesMatch "(?i:\.(php|json|sql|md|log|env|bak|old|dist|map|yml|yaml|xml|lock|git.*))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Forbid direct HTTP access to internal plugin directories
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(database|migrations|src|tests|views|release)/ - [F,L]
</IfModule>

